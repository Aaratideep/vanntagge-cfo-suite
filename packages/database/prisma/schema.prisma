datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  FOLLOW_UP
  CONVERTED
  LOST
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpMode {
  CALL
  MEETING
  WHATSAPP
  EMAIL
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  SUSPENDED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  REVIEW_PENDING
  COMPLETED
}

enum ReviewSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStatus {
  PENDING
  RESOLVED
  APPROVED
}

enum DocCategory {
  COMPANY_MASTER_DATA
  LEGAL_COMPLIANCE
  FINANCIAL_COMPLIANCE
}

enum DocStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
  MISSING
}

enum ComplianceType {
  GST
  TDS
  INCOME_TAX
  ROC
  PAYROLL
  PF
  ESIC
  PROFESSIONAL_TAX
  ANNUAL_COMPLIANCE
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CollectionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  BAD_DEBT
}

enum ReportType {
  MIS
  FINANCIAL_ANALYSIS
  BUSINESS_VALUATION
  DUE_DILIGENCE
  CASH_FLOW
  BUDGET
  FORECAST
  COMPLIANCE
}

enum ReportStatus {
  DRAFT
  INTERNAL_REVIEW
  FINAL_DRAFT
  APPROVED
  RELEASED
}

// ==========================================
// CORE ENTITIES (PHASE 0)
// ==========================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  leads             Lead[]
  clients           Client[]
  engagements       Engagement[]
  serviceCategories ServiceCategory[]
  financialPeriods  FinancialPeriod[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  name           String
  passwordHash   String
  role           Role         @default(EMPLOYEE)
  permissions    String[] // Custom individual scopes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  assignedLeads   Lead[]         @relation("AssignedExecutive")
  allocatedTasks  Task[]         @relation("TaskEmployee")
  reviewedTasks   Task[]         @relation("TaskReviewer")
  documentReviews Document[]     @relation("DocumentReviewer")
  documentUploads Document[]     @relation("DocumentUploader")
  compliances     Compliance[]   @relation("ComplianceResponsible")
  notifications   Notification[]
  auditLogs       AuditLog[]
}

// ==========================================
// SERVICE MASTER ENGINE (PHASE 1)
// ==========================================

model ServiceCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  services ServiceMaster[]
}

model ServiceMaster {
  id          String          @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean         @default(true)
  frequency   String? // Monthly, Quarterly, Annual, One-Time
  priority    Priority        @default(MEDIUM)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parameters      ServiceParameter[]
  taskTemplates   TaskTemplate[]
  reportTemplates ReportTemplate[]
  clientServices  ClientService[]
}

model ServiceParameter {
  id           String        @id @default(uuid())
  serviceId    String
  service      ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  dataType     String // BOOLEAN, STRING, NUMBER, JSON
  defaultValue String?
  isRequired   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientServiceParams ClientServiceParameter[]
}

model TaskTemplate {
  id                 String        @id @default(uuid())
  serviceId          String
  service            ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  estimatedHours     Decimal       @db.Decimal(6, 2)
  priority           Priority      @default(MEDIUM)
  isRecurring        Boolean       @default(false)
  recurringFrequency String? // e.g. "Monthly"
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tasks              Task[]
}

// ==========================================
// CRM MODULE
// ==========================================

model Lead {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName     String
  contactPerson   String
  email           String
  phone           String
  industry        String
  businessType    String
  leadSource      String
  expectedRevenue Decimal      @db.Decimal(12, 2)
  priority        Priority     @default(MEDIUM)
  status          LeadStatus   @default(NEW)
  nextFollowUp    DateTime?
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Executive Assignment
  assignedExecutiveId String?
  assignedExecutive   User?   @relation("AssignedExecutive", fields: [assignedExecutiveId], references: [id])

  // Relations
  followUps         FollowUp[]
  quotations        Quotation[]
  engagementLetters EngagementLetter[]
  clients           Client[]
  engagements       Engagement[]
}

model FollowUp {
  id               String         @id @default(uuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date             DateTime
  time             String
  mode             FollowUpMode
  notes            String
  nextFollowUpDate DateTime?
  reminderSent     Boolean        @default(false)
  status           FollowUpStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  leadId          String
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  services        Json // List of service items: { name: string, price: number }
  price           Decimal         @db.Decimal(12, 2)
  gst             Decimal         @db.Decimal(12, 2)
  discount        Decimal         @db.Decimal(12, 2)
  finalAmount     Decimal         @db.Decimal(12, 2)
  validity        DateTime
  status          QuotationStatus @default(DRAFT)
  version         Int             @default(1)
  terms           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  engagementLetters EngagementLetter[]
}

model EngagementLetter {
  id               String    @id @default(uuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id])
  serviceScope     String
  deliverables     String
  timeline         String
  fees             Decimal   @db.Decimal(12, 2)
  paymentSchedule  Json // Milestones list
  responsibilities String
  terms            String
  digitalSignature String? // Image URL or Base64 signature verification
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ==========================================
// CLIENT & ENGAGEMENT ENGINE
// ==========================================

model Client {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id])
  companyName     String       @unique
  contactPerson   String
  email           String
  phone           String
  tallyLedgerGuid String?      @unique
  isLegacy        Boolean      @default(false)
  status          ClientStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  engagements      Engagement[]
  financialPeriods FinancialPeriod[]
}

model Engagement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  name           String
  status         ClientStatus @default(ACTIVE)
  startDate      DateTime     @default(now())
  endDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations 
  services       EngagementService[]
  clientServices ClientService[]
  tasks          Task[]
  documents      Document[]
  compliances    Compliance[]
  invoices       Invoice[]
  reports        Report[]
  collections    Collection[]
}

model EngagementService {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  serviceName  String
  price        Decimal    @db.Decimal(12, 2)
  billingCycle String // e.g. "Milestone", "Monthly", "One-Time"
}

model ClientService {
  id              String        @id @default(uuid())
  engagementId    String
  engagement      Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  serviceMasterId String
  serviceMaster   ServiceMaster @relation(fields: [serviceMasterId], references: [id], onDelete: Cascade)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clientParameters ClientServiceParameter[]
}

model ClientServiceParameter {
  id                 String           @id @default(uuid())
  clientServiceId    String
  clientService      ClientService    @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  serviceParameterId String
  serviceParameter   ServiceParameter @relation(fields: [serviceParameterId], references: [id], onDelete: Cascade)
  value              String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ==========================================
// WORK & TASK ENGINE
// ==========================================

model Task {
  id             String     @id @default(uuid())
  engagementId   String
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title          String
  milestone      String
  estimatedHours Decimal    @db.Decimal(6, 2)
  timeSpent      Decimal    @default(0.0) @db.Decimal(6, 2)
  progress       Int        @default(0) // 0-100%
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(NOT_STARTED)
  dependencies   String? // Comma separated task IDs
  notes          String?
  dueDate        DateTime?
  taskTemplateId String?
  taskTemplate   TaskTemplate? @relation(fields: [taskTemplateId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Team
  employeeId String?
  employee   User?   @relation("TaskEmployee", fields: [employeeId], references: [id])
  reviewerId String?
  reviewer   User?   @relation("TaskReviewer", fields: [reviewerId], references: [id])

  // Relations
  reviewPoints ReviewPoint[]
}

// ==========================================
// REVIEW ENGINE
// ==========================================

model ReviewPoint {
  id            String         @id @default(uuid())
  taskId        String
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category      String
  severity      ReviewSeverity @default(MEDIUM)
  description   String
  screenshotUrl String?
  status        ReviewStatus   @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ==========================================
// DOCUMENTS & COMPLIANCE
// ==========================================

model Document {
  id           String      @id @default(uuid())
  engagementId String
  engagement   Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  category     DocCategory
  name         String
  status       DocStatus   @default(PENDING)
  filePath     String?
  dueDate      DateTime?
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Staff assigned to check / upload
  reviewerId String?
  reviewer   User?   @relation("DocumentReviewer", fields: [reviewerId], references: [id])
  uploaderId String?
  uploader   User?   @relation("DocumentUploader", fields: [uploaderId], references: [id])
}

model Compliance {
  id             String           @id @default(uuid())
  engagementId   String
  engagement     Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  type           ComplianceType
  dueDate        DateTime
  status         ComplianceStatus @default(PENDING)
  completionDate DateTime?
  documentsUrl   String?
  reminderDays   Int              @default(7) // Days before due date to remind
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Responsible Staff
  responsibleEmployeeId String?
  responsibleEmployee   User?   @relation("ComplianceResponsible", fields: [responsibleEmployeeId], references: [id])
}

// ==========================================
// BILLING ENGINE
// ==========================================

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  engagementId   String
  engagement     Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  milestone      String
  amount         Decimal       @db.Decimal(12, 2)
  gst            Decimal       @db.Decimal(12, 2)
  finalAmount    Decimal       @db.Decimal(12, 2)
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  tallyVoucherId String?
  paymentTerms   String?
  filePath       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  collections Collection[]
}

model Collection {
  id            String           @id @default(uuid())
  engagementId  String
  engagement    Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  outstanding   Decimal          @db.Decimal(12, 2)
  collected     Decimal          @db.Decimal(12, 2)
  overdue       Decimal          @db.Decimal(12, 2)
  status        CollectionStatus @default(PENDING)
  paymentDate   DateTime?
  paymentMethod String?
  transactionId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ==========================================
// REPORT ENGINE
// ==========================================

model ReportTemplate {
  id              String        @id @default(uuid())
  serviceMasterId String
  serviceMaster   ServiceMaster @relation(fields: [serviceMasterId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections ReportTemplateSection[]
  reports  Report[]
}

model ReportTemplateSection {
  id               String         @id @default(uuid())
  reportTemplateId String
  reportTemplate   ReportTemplate @relation(fields: [reportTemplateId], references: [id], onDelete: Cascade)
  name             String
  order            Int
  sectionType      String // TABLE, CHART, TEXT, KPI
  config           Json? // Storing dynamic config for the section
}

model Report {
  id               String          @id @default(uuid())
  engagementId     String
  engagement       Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reportTemplateId String?
  reportTemplate   ReportTemplate? @relation(fields: [reportTemplateId], references: [id])
  type             ReportType // Keeping this for backward compatibility
  name             String
  status           ReportStatus    @default(DRAFT)
  periodStart      DateTime?
  periodEnd        DateTime?
  filePath         String?
  version          Int             @default(1)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  data ReportData[]
}

model ReportData {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionName String
  dataKey     String
  dataValue   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// AUDIT & NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ==========================================
// STRUCTURED FINANCIAL DATA (PHASE 4)
// ==========================================

model FinancialPeriod {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  month          Int          // 1-12
  year           Int
  status         DocStatus    @default(PENDING) // PENDING, APPROVED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  cashFlowData   CashFlowData?
  metrics        FinancialMetric[]

  @@unique([clientId, month, year])
}

model CashFlowData {
  id                String          @id @default(uuid())
  financialPeriodId String          @unique
  financialPeriod   FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)

  // Raw inputs
  openingCash       Decimal         @default(0) @db.Decimal(15, 2)
  receipts          Decimal         @default(0) @db.Decimal(15, 2)
  payments          Decimal         @default(0) @db.Decimal(15, 2)
  operatingExpenses Decimal         @default(0) @db.Decimal(15, 2)
  financeCosts      Decimal         @default(0) @db.Decimal(15, 2)
  loanRepayments    Decimal         @default(0) @db.Decimal(15, 2)
  closingCash       Decimal         @default(0) @db.Decimal(15, 2)

  // Computed fields (optional to store, can be computed on the fly, but good for querying)
  netCashFlow       Decimal         @default(0) @db.Decimal(15, 2)
  cashBurn          Decimal         @default(0) @db.Decimal(15, 2)
  runwayMonths      Decimal         @default(0) @db.Decimal(6, 2)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model FinancialMetric {
  id                String          @id @default(uuid())
  financialPeriodId String
  financialPeriod   FinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)
  
  name              String          // e.g. "EBITDA", "CAC", "LTV"
  value             Decimal         @db.Decimal(15, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([financialPeriodId, name])
}


model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

model TallySyncLog {
  id          String   @id @default(uuid())
  entityType  String // 'INVOICE', 'RECEIPT', 'LEDGER'
  entityId    String
  syncStatus  String // 'SUCCESS', 'FAILED', 'PENDING'
  xmlRequest  String?  @db.Text
  xmlResponse String?  @db.Text
  syncedAt    DateTime @default(now())
}
