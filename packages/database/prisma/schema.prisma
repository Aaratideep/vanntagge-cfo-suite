datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CLIENT
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  FOLLOW_UP
  CONVERTED
  LOST
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpMode {
  CALL
  MEETING
  WHATSAPP
  EMAIL
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  SUSPENDED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  REVIEW_PENDING
  COMPLETED
}

enum ReviewSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStatus {
  PENDING
  RESOLVED
  APPROVED
}

enum DocCategory {
  COMPANY_MASTER_DATA
  LEGAL_COMPLIANCE
  FINANCIAL_COMPLIANCE
}

enum DocStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
  MISSING
}

enum ComplianceType {
  GST
  TDS
  INCOME_TAX
  ROC
  PAYROLL
  PF
  ESIC
  PROFESSIONAL_TAX
  ANNUAL_COMPLIANCE
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CollectionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  BAD_DEBT
}

enum ReportType {
  MIS
  FINANCIAL_ANALYSIS
  BUSINESS_VALUATION
  DUE_DILIGENCE
  CASH_FLOW
  BUDGET
  FORECAST
  COMPLIANCE
}

enum ReportStatus {
  DRAFT
  INTERNAL_REVIEW
  FINAL_DRAFT
  APPROVED
  RELEASED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(EMPLOYEE)
  permissions  String[]      // Custom individual scopes
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  assignedLeads     Lead[]    @relation("AssignedExecutive")
  allocatedTasks    Task[]    @relation("TaskEmployee")
  reviewedTasks     Task[]    @relation("TaskReviewer")
  documentReviews   Document[] @relation("DocumentReviewer")
  documentUploads   Document[] @relation("DocumentUploader")
  compliances       Compliance[] @relation("ComplianceResponsible")
  notifications     Notification[]
  auditLogs         AuditLog[]
}

model Lead {
  id               String       @id @default(uuid())
  companyName      String
  contactPerson    String
  email            String
  phone            String
  industry         String
  businessType     String
  leadSource       String
  expectedRevenue  Decimal      @db.Decimal(12, 2)
  priority         Priority     @default(MEDIUM)
  status           LeadStatus   @default(NEW)
  nextFollowUp     DateTime?
  remarks          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Executive Assignment
  assignedExecutiveId String?
  assignedExecutive   User?    @relation("AssignedExecutive", fields: [assignedExecutiveId], references: [id])

  // Relations
  followUps         FollowUp[]
  quotations        Quotation[]
  engagementLetters EngagementLetter[]
  clients           Client[]
  engagements       Engagement[]
}

model FollowUp {
  id               String         @id @default(uuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date             DateTime
  time             String
  mode             FollowUpMode
  notes            String
  nextFollowUpDate DateTime?
  reminderSent     Boolean        @default(false)
  status           FollowUpStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Quotation {
  id               String          @id @default(uuid())
  quotationNumber  String          @unique
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  services         Json            // List of service items: { name: string, price: number }
  price            Decimal         @db.Decimal(12, 2)
  gst              Decimal         @db.Decimal(12, 2)
  discount         Decimal         @db.Decimal(12, 2)
  finalAmount      Decimal         @db.Decimal(12, 2)
  validity         DateTime
  status           QuotationStatus @default(DRAFT)
  version          Int             @default(1)
  terms            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  // Relations
  engagementLetters EngagementLetter[]
}

model EngagementLetter {
  id              String       @id @default(uuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationId     String
  quotation       Quotation    @relation(fields: [quotationId], references: [id])
  serviceScope    String
  deliverables    String
  timeline        String
  fees            Decimal      @db.Decimal(12, 2)
  paymentSchedule Json         // Milestones list
  responsibilities String
  terms           String
  digitalSignature String?      // Image URL or Base64 signature verification
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Client {
  id            String       @id @default(uuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id])
  companyName   String       @unique
  contactPerson String
  email         String
  phone         String
  tallyLedgerGuid String?    @unique
  isLegacy      Boolean      @default(false)
  status        ClientStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  engagements Engagement[]
}

model Engagement {
  id           String        @id @default(uuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id])
  name         String
  status       ClientStatus  @default(ACTIVE)
  startDate    DateTime      @default(now())
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations - Sub modules tied to the Core Engagement
  services     EngagementService[]
  tasks        Task[]
  documents    Document[]
  compliances  Compliance[]
  invoices     Invoice[]
  reports      Report[]
  collections  Collection[]
}

model EngagementService {
  id           String     @id @default(uuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  serviceName  String
  price        Decimal    @db.Decimal(12, 2)
  billingCycle String     // e.g. "Milestone", "Monthly", "One-Time"
}

model Task {
  id             String      @id @default(uuid())
  engagementId   String
  engagement     Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title          String
  milestone      String
  estimatedHours Decimal     @db.Decimal(6, 2)
  timeSpent      Decimal     @db.Decimal(6, 2) @default(0.0)
  progress       Int         @default(0) // 0-100%
  priority       Priority    @default(MEDIUM)
  status         TaskStatus  @default(NOT_STARTED)
  dependencies   String?     // Comma separated task IDs
  notes          String?
  dueDate        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Team
  employeeId     String?
  employee       User?       @relation("TaskEmployee", fields: [employeeId], references: [id])
  reviewerId     String?
  reviewer       User?       @relation("TaskReviewer", fields: [reviewerId], references: [id])

  // Relations
  reviewPoints   ReviewPoint[]
}

model ReviewPoint {
  id           String         @id @default(uuid())
  taskId       String
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category     String
  severity     ReviewSeverity @default(MEDIUM)
  description  String
  screenshotUrl String?
  status       ReviewStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Document {
  id           String      @id @default(uuid())
  engagementId String
  engagement   Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  category     DocCategory
  name         String
  status       DocStatus   @default(PENDING)
  filePath     String?
  dueDate      DateTime?
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Staff assigned to check / upload
  reviewerId   String?
  reviewer     User?       @relation("DocumentReviewer", fields: [reviewerId], references: [id])
  uploaderId   String?
  uploader     User?       @relation("DocumentUploader", fields: [uploaderId], references: [id])
}

model Compliance {
  id           String           @id @default(uuid())
  engagementId String
  engagement   Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  type         ComplianceType
  dueDate      DateTime
  status       ComplianceStatus @default(PENDING)
  completionDate DateTime?
  documentsUrl String?
  reminderDays Int              @default(7) // Days before due date to remind
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Responsible Staff
  responsibleEmployeeId String?
  responsibleEmployee   User?    @relation("ComplianceResponsible", fields: [responsibleEmployeeId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  engagementId  String
  engagement    Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  milestone     String
  amount        Decimal       @db.Decimal(12, 2)
  gst           Decimal       @db.Decimal(12, 2)
  finalAmount   Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  tallyVoucherId String?
  paymentTerms  String?
  filePath      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  collections   Collection[]
}

model Collection {
  id              String           @id @default(uuid())
  engagementId    String
  engagement      Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  outstanding     Decimal          @db.Decimal(12, 2)
  collected       Decimal          @db.Decimal(12, 2)
  overdue         Decimal          @db.Decimal(12, 2)
  status          CollectionStatus @default(PENDING)
  paymentDate     DateTime?
  paymentMethod   String?
  transactionId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Report {
  id           String       @id @default(uuid())
  engagementId String
  engagement   Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  type         ReportType
  status       ReportStatus @default(DRAFT)
  filePath     String?
  version      Int          @default(1)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
}

model TallySyncLog {
  id           String   @id @default(uuid())
  entityType   String   // 'INVOICE', 'RECEIPT', 'LEDGER'
  entityId     String
  syncStatus   String   // 'SUCCESS', 'FAILED', 'PENDING'
  xmlRequest   String?  @db.Text
  xmlResponse  String?  @db.Text
  syncedAt     DateTime @default(now())
}
